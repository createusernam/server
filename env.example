# Пример файла .env для Spacebar Server
# Скопируйте этот файл в .env и заполните своими значениями
# cp env.example .env
# nano .env

# База данных PostgreSQL
DATABASE=postgres://spacebar:password@localhost:5432/spacebar

# WebRTC настройки
# Публичный IP или домен для WebRTC сервера (используется в SDP)
# Используйте домен если настроен nginx, или публичный IP сервера
WRTC_PUBLIC_IP=storytable.ru

# Альтернативно можно использовать публичный IP:
# WRTC_PUBLIC_IP=141.98.188.77
